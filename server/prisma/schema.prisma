// MEDMAP 3D — database schema (MySQL / MariaDB)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BodySide {
  LEFT
  RIGHT
  CENTER
}

enum BodyView {
  FRONT
  BACK
  BOTH
}

enum ReportStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  COMPLETED
  REJECTED
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

enum RecordType {
  EXAMINATION
  CONSULTATION
  LAB_RESULT
  FOLLOW_UP
}

enum NoteVisibility {
  SHARED
  PRIVATE
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  EXPIRED
  CANCELLED
}

enum ConsentStatus {
  ACTIVE
  REVOKED
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(191)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(120)
  role            Role      @default(PATIENT)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  patientProfile     PatientProfile?
  doctorProfile      DoctorProfile?
  pharmacyProfile    PharmacyProfile?
  consentsGranted    PatientConsent[]    @relation("ConsentGrantee")
  notifications      Notification[]
  activityLogs       ActivityLog[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  emailLogs          EmailLog[]

  @@index([role])
  @@map("users")
}

model PatientProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  patientCode       String    @unique @map("patient_code") @db.VarChar(20)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  gender            Gender?
  phone             String?   @db.VarChar(30)
  bloodType         String?   @map("blood_type") @db.VarChar(10)
  heightCm          Int?      @map("height_cm")
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(5, 1)
  allergies         String?   @db.Text
  chronicConditions String?   @map("chronic_conditions") @db.Text
  emergencyContact  String?   @map("emergency_contact") @db.VarChar(160)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  symptomReports SymptomReport[]
  medicalRecords MedicalRecord[]
  doctorNotes    DoctorNote[]
  prescriptions  Prescription[]
  consents       PatientConsent[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  specialization  String   @db.VarChar(120)
  licenseNumber   String   @unique @map("license_number") @db.VarChar(40)
  clinic          String?  @db.VarChar(160)
  phone           String?  @db.VarChar(30)
  yearsExperience Int?     @map("years_experience")
  bio             String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalRecords MedicalRecord[]
  doctorNotes    DoctorNote[]
  prescriptions  Prescription[]

  @@map("doctor_profiles")
}

model PharmacyProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  pharmacyName  String   @map("pharmacy_name") @db.VarChar(160)
  licenseNumber String   @unique @map("license_number") @db.VarChar(40)
  address       String?  @db.VarChar(255)
  phone         String?  @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pharmacy_profiles")
}

model BodyArea {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(40)
  nameEn      String   @map("name_en") @db.VarChar(60)
  nameKk      String   @map("name_kk") @db.VarChar(60)
  side        BodySide @default(CENTER)
  view        BodyView @default(BOTH)
  description String   @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  symptomReports SymptomReport[]

  @@map("body_areas")
}

model SymptomReport {
  id                 Int          @id @default(autoincrement())
  applicationNo      String       @unique @map("application_no") @db.VarChar(20)
  patientId          Int          @map("patient_id")
  contactName        String       @map("contact_name") @db.VarChar(120)
  contactEmail       String       @map("contact_email") @db.VarChar(191)
  contactPhone       String?      @map("contact_phone") @db.VarChar(30)
  submissionKey      String?      @unique @map("submission_key") @db.VarChar(64)
  bodyAreaId         Int          @map("body_area_id")
  description        String       @db.Text
  startedAt          DateTime     @map("started_at") @db.Date
  duration           String       @db.VarChar(60)
  intensity          Int          @db.TinyInt
  additionalSymptoms String?      @map("additional_symptoms") @db.Text
  visitedDoctor      Boolean      @default(false) @map("visited_doctor")
  visitDetails       String?      @map("visit_details") @db.Text
  status             ReportStatus @default(NEW)
  statusChangedAt    DateTime?    @map("status_changed_at")
  adminSeenAt        DateTime?    @map("admin_seen_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  patient        PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bodyArea       BodyArea           @relation(fields: [bodyAreaId], references: [id], onDelete: Restrict)
  attachments    ReportAttachment[]
  medicalRecords MedicalRecord[]
  doctorNotes    DoctorNote[]

  @@index([patientId, createdAt])
  @@index([bodyAreaId])
  @@index([status])
  @@index([adminSeenAt])
  @@map("symptom_reports")
}

model ReportAttachment {
  id              Int      @id @default(autoincrement())
  symptomReportId Int      @map("symptom_report_id")
  originalName    String   @map("original_name") @db.VarChar(255)
  storedName      String   @unique @map("stored_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  createdAt       DateTime @default(now()) @map("created_at")

  symptomReport SymptomReport @relation(fields: [symptomReportId], references: [id], onDelete: Cascade)

  @@index([symptomReportId])
  @@map("report_attachments")
}

model MedicalRecord {
  id              Int        @id @default(autoincrement())
  patientId       Int        @map("patient_id")
  doctorId        Int        @map("doctor_id")
  symptomReportId Int?       @map("symptom_report_id")
  recordType      RecordType @default(EXAMINATION) @map("record_type")
  title           String     @db.VarChar(200)
  conclusion      String     @db.Text
  recommendations String?    @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  symptomReport SymptomReport? @relation(fields: [symptomReportId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]
  doctorNotes   DoctorNote[]

  @@index([patientId, createdAt])
  @@index([doctorId])
  @@map("medical_records")
}

model DoctorNote {
  id              Int            @id @default(autoincrement())
  patientId       Int            @map("patient_id")
  doctorId        Int            @map("doctor_id")
  medicalRecordId Int?           @map("medical_record_id")
  symptomReportId Int?           @map("symptom_report_id")
  content         String         @db.Text
  visibility      NoteVisibility @default(SHARED)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  symptomReport SymptomReport? @relation(fields: [symptomReportId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([doctorId])
  @@map("doctor_notes")
}

model Medication {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique @db.VarChar(120)
  activeIngredient     String   @map("active_ingredient") @db.VarChar(160)
  drugClass            String?  @map("drug_class") @db.VarChar(120)
  dosageForms          String?  @map("dosage_forms") @db.Text
  indications          String   @db.Text
  contraindications    String   @db.Text
  prescriptionRequired Boolean  @default(true) @map("prescription_required")
  availabilityNote     String?  @map("availability_note") @db.VarChar(255)
  sourceName           String   @map("source_name") @db.VarChar(160)
  sourceUrl            String   @map("source_url") @db.VarChar(500)
  sourceCheckedAt      DateTime @map("source_checked_at") @db.Date
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  prescriptions Prescription[]

  @@index([activeIngredient])
  @@map("medications")
}

model Prescription {
  id              Int                @id @default(autoincrement())
  code            String             @unique @db.VarChar(20)
  patientId       Int                @map("patient_id")
  doctorId        Int                @map("doctor_id")
  medicationId    Int                @map("medication_id")
  medicalRecordId Int?               @map("medical_record_id")
  dosage          String             @db.VarChar(120)
  frequency       String             @db.VarChar(120)
  durationDays    Int                @map("duration_days")
  instructions    String?            @db.Text
  status          PrescriptionStatus @default(ACTIVE)
  pharmacyAccess  Boolean            @default(false) @map("pharmacy_access")
  issuedAt        DateTime           @default(now()) @map("issued_at")
  validUntil      DateTime           @map("valid_until")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  medication    Medication     @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("prescriptions")
}

model PatientConsent {
  id            Int           @id @default(autoincrement())
  patientId     Int           @map("patient_id")
  granteeUserId Int           @map("grantee_user_id")
  status        ConsentStatus @default(ACTIVE)
  note          String?       @db.VarChar(255)
  grantedAt     DateTime      @default(now()) @map("granted_at")
  revokedAt     DateTime?     @map("revoked_at")
  expiresAt     DateTime?     @map("expires_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantee User           @relation("ConsentGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([patientId, granteeUserId])
  @@index([granteeUserId, status])
  @@map("patient_consents")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String    @db.VarChar(160)
  message   String    @db.Text
  type      String    @default("info") @db.VarChar(30)
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(80)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  codeHash   String    @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verifications")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

model EmailLog {
  id        Int         @id @default(autoincrement())
  userId    Int?        @map("user_id")
  toAddress String      @map("to_address") @db.VarChar(191)
  subject   String      @db.VarChar(255)
  template  String      @db.VarChar(60)
  status    EmailStatus
  error     String?     @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@map("email_logs")
}
