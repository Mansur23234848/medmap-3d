# Copy to server/.env and fill in values (START_MEDMAP.bat creates it automatically on first run).

# XAMPP MySQL / MariaDB. Port: see C:\xampp\mysql\bin\my.ini ("port=").
DATABASE_URL="mysql://root:@127.0.0.1:3306/medmap3d"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN="8h"
PORT=4000
CLIENT_ORIGIN="http://localhost,http://127.0.0.1,http://localhost:4000,http://localhost:5173"
APP_URL="http://localhost/medmap3d"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5
NODE_ENV=development

# ---- Gmail SMTP: use a Google App Password (Google account → Security → 2-Step Verification → App passwords) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
EMAIL_DEV_FALLBACK=true
